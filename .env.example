# ==============================================================================
# SMART RENTAL HOUSE MANAGEMENT AND DISCOVERY PLATFORM - ENVIRONMENT TEMPLATE
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_rental_db?schema=public

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_for_smart_rental_platform_2026_dev_mode
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Payment Gateway (Razorpay Sandbox/Test Mode)
PAYMENT_KEY_ID=rzp_test_samplekey123456
PAYMENT_KEY_SECRET=rzp_secret_samplekey789012
PAYMENT_WEBHOOK_SECRET=rzp_webhook_secret_xyz

# Maps Service (OpenStreetMap is default / optional API keys for forward geocoding)
MAP_PROVIDER=openstreetmap
MAP_API_KEY=

# ML Recommendation Service (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Email Notification Service (SMTP)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=demo_user@ethereal.email
EMAIL_PASSWORD=demo_password
EMAIL_FROM="Smart Rental Platform" <no-reply@smartrental.local>

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
